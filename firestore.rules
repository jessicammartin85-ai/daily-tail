rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(ownerUid) {
      return signedIn() && request.auth.uid == ownerUid;
    }
    function hasDogRole(ownerUid, dogId, role) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(ownerUid)/members/$(request.auth.uid)/dogs/$(dogId))
        && get(/databases/$(database)/documents/users/$(ownerUid)/members/$(request.auth.uid)/dogs/$(dogId)).data.role == role;
    }
    function isDogAdmin(ownerUid, dogId) {
      return isOwner(ownerUid) || hasDogRole(ownerUid, dogId, 'adult');
    }
    function isDogMember(ownerUid, dogId) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(ownerUid)/members/$(request.auth.uid)/dogs/$(dogId));
    }

    function publicShareId(ownerUid, dogId) {
      return get(/databases/$(database)/documents/users/$(ownerUid)/publicShareLinks/$(dogId)).data.shareId;
    }
    function isPublicPost(ownerUid, dogId, postId) {
      return exists(/databases/$(database)/documents/users/$(ownerUid)/publicShareLinks/$(dogId))
        && exists(/databases/$(database)/documents/publicProfiles/$(publicShareId(ownerUid, dogId)))
        && get(/databases/$(database)/documents/publicProfiles/$(publicShareId(ownerUid, dogId))).data.ownerUid == ownerUid
        && get(/databases/$(database)/documents/publicProfiles/$(publicShareId(ownerUid, dogId))).data.dogId == dogId
        && get(/databases/$(database)/documents/publicProfiles/$(publicShareId(ownerUid, dogId))).data.active == true
        && get(/databases/$(database)/documents/publicProfiles/$(publicShareId(ownerUid, dogId))).data.get('postIds', []).hasAny([postId]);
    }
    function canViewPost(ownerUid, dogId, postId) {
      return isDogAdmin(ownerUid, dogId)
        || (isDogMember(ownerUid, dogId)
          && get(/databases/$(database)/documents/users/$(ownerUid)/sharedProfiles/$(dogId)).data.get('postIds', []).hasAny([postId]))
        || isPublicPost(ownerUid, dogId, postId);
    }

    // The original cloud sync snapshot belongs only to its Firebase account.
    // Do not grant invited members access to this private subtree.
    match /users/{ownerUid} {
      allow read, write: if isOwner(ownerUid);

      match /{privateDocument=**} {
        allow read, write: if isOwner(ownerUid);
      }

      // One heart per authenticated account. No child can change dog data here.
      match /dogSocial/{dogId}/posts/{postId}/hearts/{accountUid} {
        allow get, list: if canViewPost(ownerUid, dogId, postId);
        allow create: if signedIn() && request.auth.uid == accountUid
          && canViewPost(ownerUid, dogId, postId)
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time;
        allow delete: if signedIn() && request.auth.uid == accountUid
          && canViewPost(ownerUid, dogId, postId);
        allow update: if false;
      }

      // Child and Friend comments stay private until an Adult Owner approves.
      match /commentRequests/{commentId} {
        allow get, list: if isOwner(ownerUid) || isDogAdmin(ownerUid, resource.data.dogId)
          || (canViewPost(ownerUid, resource.data.dogId, resource.data.postId)
            && (resource.data.status == 'approved'
              || (signedIn() && resource.data.authorUid == request.auth.uid)));
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['dogId','postId','postTitle','authorUid','authorName','text','status','createdAt'])
          && canViewPost(ownerUid, request.resource.data.dogId, request.resource.data.postId)
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() <= 100
          && request.resource.data.postId is string
          && request.resource.data.postId.size() > 0
          && request.resource.data.postId.size() <= 128
          && request.resource.data.postTitle is string
          && request.resource.data.postTitle.size() <= 180
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 280
          && request.resource.data.createdAt == request.time
          && (request.resource.data.status == 'pending'
            || (request.resource.data.status == 'approved'
              && isDogAdmin(ownerUid, request.resource.data.dogId)));
        allow update: if isDogAdmin(ownerUid, resource.data.dogId)
          && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedBy','reviewedAt'])
          && request.resource.data.status in ['approved','declined']
          && request.resource.data.reviewedBy == request.auth.uid
          && request.resource.data.reviewedAt == request.time;
        allow delete: if isDogAdmin(ownerUid, resource.data.dogId);
      }

      // Cloud-native dog data is private to its owner and approved Adult Owners.
      // Child Owners submit proposed changes; Friends use published read-only views.
      // The broad owner-only rule above remains valid. Overlapping Firebase rules
      // grant member access only to these exact per-dog records.
      match /dogsV2/{dogId} {
        allow get: if isOwner(ownerUid) || hasDogRole(ownerUid,dogId,'adult');
        allow list: if isOwner(ownerUid);
        allow create, delete: if isOwner(ownerUid);
        allow update: if isOwner(ownerUid)
          || (hasDogRole(ownerUid,dogId,'adult')
            && request.resource.data.ownerUid == resource.data.ownerUid
            && request.resource.data.id == resource.data.id);
        match /versions/{version}/parts/{part} {
          allow read, create, update: if isOwner(ownerUid) || hasDogRole(ownerUid,dogId,'adult');
          allow delete: if isOwner(ownerUid);
        }
      }

      // The recipient may maintain only their own verified joined-dog pointer.
      match /joinedDogs/{joinId} {
        allow get, list, delete: if isOwner(ownerUid);
        allow create, update: if isOwner(ownerUid)
          && request.resource.data.keys().hasOnly(['ownerUid','dogId','role','name','joinedAt'])
          && request.resource.data.ownerUid is string
          && request.resource.data.dogId is string
          && request.resource.data.role in ['adult','child']
          && getAfter(/databases/$(database)/documents/users/$(request.resource.data.ownerUid)/members/$(ownerUid)/dogs/$(request.resource.data.dogId)).data.role == request.resource.data.role;
      }

      // Only an existing Adult Owner may grant or revoke family membership.
      match /members/{memberUid}/dogs/{dogId} {
        allow get: if isDogAdmin(ownerUid, dogId)
          || (signedIn() && request.auth.uid == memberUid);
        allow list, delete: if isDogAdmin(ownerUid, dogId);
        allow create, update: if isDogAdmin(ownerUid, dogId)
          && request.resource.data.keys().hasOnly(['role','inviteId','addedAt','accountName','accountEmail'])
          && request.resource.data.role in ['adult','child'];
        // Members may update identity labels only, using their authenticated email.
        allow update: if signedIn() && request.auth.uid == memberUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accountName','accountEmail'])
          && request.resource.data.accountName is string
          && request.resource.data.accountEmail == request.auth.token.email;
      }

      match /dogAccounts/{dogId} {
        allow get: if isDogAdmin(ownerUid, dogId);
        allow create, update: if isOwner(ownerUid)
          && request.resource.data.keys().hasOnly(['accountName','accountEmail'])
          && request.resource.data.accountName is string
          && request.resource.data.accountEmail == request.auth.token.email;
        allow delete: if isOwner(ownerUid);
      }

      // A deliberately limited, owner-published shared view. No private
      // schedules, journal, emergency contacts, access codes, or cloud backups.
      match /sharedProfiles/{dogId} {
        allow get: if isOwner(ownerUid) || isDogMember(ownerUid, dogId);
        allow list: if isOwner(ownerUid);
        allow create, delete: if isDogAdmin(ownerUid, dogId);
        allow update: if isOwner(ownerUid)
          || (hasDogRole(ownerUid, dogId, 'adult')
            && request.resource.data.keys().hasOnly(['name', 'breed', 'dob', 'personality', 'favorites', 'cuteFact', 'photo', 'posts', 'postIds', 'updatedAt']));
      }

      match /joinRequests/{requestId} {
        allow get: if signedIn() && (
          !exists(/databases/$(database)/documents/users/$(ownerUid)/joinRequests/$(requestId))
          || resource.data.requesterUid == request.auth.uid
          || isDogAdmin(ownerUid, resource.data.dogId));
        allow list: if isOwner(ownerUid) || hasDogRole(ownerUid, resource.data.dogId, 'adult');
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['ownerUid','dogId','requesterUid','requesterName','requesterEmail','inviteId','role','status','createdAt'])
          && request.resource.data.ownerUid == ownerUid
          && request.resource.data.requesterUid == request.auth.uid
          && request.resource.data.requesterName is string
          && request.resource.data.requesterEmail == request.auth.token.email
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == request.time
          && request.resource.data.role in ['adult','child']
          && request.resource.data.inviteId is string
          && exists(/databases/$(database)/documents/invites/$(request.resource.data.inviteId))
          && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteId)).data.ownerUid == ownerUid
          && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteId)).data.dogId == request.resource.data.dogId
          && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteId)).data.role == request.resource.data.role
          && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteId)).data.active == true
          && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteId)).data.expiresAt > request.time;
        allow update: if isDogAdmin(ownerUid, resource.data.dogId)
          && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['approved','declined'];
        allow delete: if isDogAdmin(ownerUid, resource.data.dogId);
      }

      // Child edits are proposals only. They never directly modify a profile.
      match /proposedChanges/{proposalId} {
        allow get: if isDogAdmin(ownerUid, resource.data.dogId)
          || (signedIn() && resource.data.authorUid == request.auth.uid);
        allow list: if isOwner(ownerUid) || hasDogRole(ownerUid, resource.data.dogId, 'adult');
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['authorUid', 'dogId', 'kind', 'payload', 'status', 'createdAt'])
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.dogId is string
          && request.resource.data.kind in ['photo', 'post', 'profile']
          && request.resource.data.status == 'pending'
          && hasDogRole(ownerUid, request.resource.data.dogId, 'child');
        allow update, delete: if isDogAdmin(ownerUid, resource.data.dogId);
      }
    }

    // Deliberately published, read-only Friend View snapshots.
    // Only documents with a hard-to-guess link ID and active=true can be read
    // without signing in. No listing or access to private user data.
    match /publicProfiles/{shareId} {
      allow get: if resource.data.active == true
        || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.active == true
        && request.resource.data.get('sharedSections', {}) is map
        && request.resource.data.get('sharedSections', {}).keys().hasOnly(['training','hosting','attending','gifts'])
        && request.resource.data.keys().hasOnly([
          'ownerUid','dogId','active','name','breed','dob','personality',
          'favorites','cuteFact','photo','posts','postIds','updatedAt','sharedSections'
        ]);
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.dogId == resource.data.dogId
        && request.resource.data.get('sharedSections', {}) is map
        && request.resource.data.get('sharedSections', {}).keys().hasOnly(['training','hosting','attending','gifts'])
        && request.resource.data.keys().hasOnly([
          'ownerUid','dogId','active','name','breed','dob','personality',
          'favorites','cuteFact','photo','posts','postIds','updatedAt','sharedSections'
        ]);
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // Discovery is strictly opt-in. Only a small public card is exposed.
    // Search and browse queries must filter discoverable == true.
    match /directory/{listingId} {
      allow get, list: if resource.data.discoverable == true
        || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.dogId is string
        && request.resource.data.discoverable == true
        && request.resource.data.keys().hasOnly([
          'ownerUid','dogId','discoverable','dogName','dogNameLower',
          'username','usernameLower','breed','photo','shareId','updatedAt'
        ])
        && request.resource.data.dogName is string
        && request.resource.data.username is string
        && request.resource.data.shareId is string
        && exists(/databases/$(database)/documents/publicProfiles/$(request.resource.data.shareId))
        && get(/databases/$(database)/documents/publicProfiles/$(request.resource.data.shareId)).data.ownerUid == request.auth.uid
        && get(/databases/$(database)/documents/publicProfiles/$(request.resource.data.shareId)).data.dogId == request.resource.data.dogId
        && get(/databases/$(database)/documents/publicProfiles/$(request.resource.data.shareId)).data.active == true;
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.dogId == resource.data.dogId
        && request.resource.data.keys().hasOnly([
          'ownerUid','dogId','discoverable','dogName','dogNameLower',
          'username','usernameLower','breed','photo','shareId','updatedAt'
        ]);
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // Only a signed-in requester can ask to connect. Owners approve or
    // decline their own dog requests. Requests are not public.
    match /friendRequests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'requesterUid','requesterName','targetOwnerUid','dogId','listingId',
          'status','createdAt','updatedAt'
        ])
        && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.targetOwnerUid != request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.requesterName is string
        && request.resource.data.dogId is string
        && request.resource.data.listingId is string
        && exists(/databases/$(database)/documents/directory/$(request.resource.data.listingId))
        && get(/databases/$(database)/documents/directory/$(request.resource.data.listingId)).data.ownerUid == request.resource.data.targetOwnerUid
        && get(/databases/$(database)/documents/directory/$(request.resource.data.listingId)).data.dogId == request.resource.data.dogId
        && get(/databases/$(database)/documents/directory/$(request.resource.data.listingId)).data.discoverable == true;
      allow get, list: if signedIn()
        && (resource.data.requesterUid == request.auth.uid
          || resource.data.targetOwnerUid == request.auth.uid);
      allow update: if signedIn()
        && resource.data.targetOwnerUid == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
        && request.resource.data.status in ['approved','declined'];
      allow delete: if signedIn()
        && (resource.data.requesterUid == request.auth.uid
          || resource.data.targetOwnerUid == request.auth.uid);
    }

    // Links allow requests only. An existing Adult Owner must grant membership.
    match /invites/{inviteId} {
      allow get: if signedIn();
      allow list: if isDogAdmin(resource.data.ownerUid, resource.data.dogId);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['ownerUid','dogId','name','role','active','createdAt','expiresAt'])
        && isDogAdmin(request.resource.data.ownerUid, request.resource.data.dogId)
        && request.resource.data.role in ['adult','child']
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt < request.time + duration.value(8, 'd')
        && request.resource.data.active == true;
      allow update: if isDogAdmin(resource.data.ownerUid, resource.data.dogId)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.dogId == resource.data.dogId
        && request.resource.data.role == resource.data.role;
      allow delete: if isDogAdmin(resource.data.ownerUid, resource.data.dogId);
    }
  }
}
